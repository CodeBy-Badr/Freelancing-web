{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir": "./public/assets/js",
    "rootDir": "./public/assets/js",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "removeComments": false,
    "declaration": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "public/assets/js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
